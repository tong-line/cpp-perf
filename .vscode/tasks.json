{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MyTinySTL: configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}/MyTinySTL",
        "-B",
        "${workspaceFolder}/MyTinySTL/build",
        "-G",
        "Ninja",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "problemMatcher": []
    },
    {
      "label": "MyTinySTL: build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/MyTinySTL/build",
        "--parallel"
      ],
      "dependsOn": "MyTinySTL: configure",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "MyTinySTL: test",
      "type": "shell",
      "command": "${workspaceFolder}/MyTinySTL/bin/stltest",
      "dependsOn": "MyTinySTL: build",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
